<UserControl x:Class="AnnoMapEditor.UI.Overlays.SelectSlots.SelectSlotsOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AnnoMapEditor.UI.Overlays.SelectSlots"
        xmlns:converters="clr-namespace:AnnoMapEditor.UI.Converters"
        xmlns:controls="clr-namespace:AnnoMapEditor.UI.Controls"
        xmlns:e="clr-namespace:EventBinder;assembly=EventBinder" Name="Wnd"
        mc:Ignorable="d"
        d:DataContext="{d:DesignData Type=local:SelectSlotsViewModel}"
        d:DesignHeight="450"
        d:DesignWidth="800"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="{StaticResource MediumBackgroundBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Resources/Styles.xaml" />
                <ResourceDictionary>
                    <DataTemplate x:Key="SelectorTemplate">
                        <ComboBox ItemsSource="{Binding SlotItems}"
                                  SelectedItem="{Binding AssignedSlot}"
                                  Height="38"
                                  Margin="2"
                                  MinWidth="150"
                                  GotFocus="{e:EventBinding OnGotFocus}"
                                  LostFocus="{e:EventBinding OnLostFocus}"
                                  MouseEnter="{e:EventBinding OnGotFocus}"
                                  MouseLeave="{e:EventBinding OnLostFocus}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Height="30"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                        <Image Source="{Binding Icon}"
                                               Width="30"
                                               Height="30"
                                               Margin="4"/>
                                        <TextBlock Text="{Binding DisplayNameWithGuid}"
                                                   Foreground="{StaticResource ForegroundBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DataTemplate>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.Resources>
            <converters:BoolToVisibility x:Key="boolToVisibility" OnTrue="Visible" OnFalse="Collapsed" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition>
                <RowDefinition.Style>
                    <Style TargetType="{x:Type RowDefinition}">
                        <Setter Property="Height" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowRegionWarning}" Value="True">
                                <Setter Property="Height" Value="30" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </RowDefinition.Style>
            </RowDefinition>
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- GUID filter and cancel button -->
        <StackPanel Grid.Column="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <ToggleButton x:Name="GuidFilterButton"
                          Content="GUID Filter"
                          Margin="2"
                          Padding="8,2"
                          IsChecked="False" />
            <Button Content="          Close          "
                    Click="{e:EventBinding OnClosed}"
                    IsCancel="True" />
        </StackPanel>

        <Popup x:Name="GuidFilterPopup"
               PlacementTarget="{Binding ElementName=GuidFilterButton}"
               DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               IsOpen="{Binding IsChecked, ElementName=GuidFilterButton, Mode=TwoWay}">
            <Border Background="{StaticResource MediumBackgroundBrush}"
                    BorderBrush="{StaticResource ForegroundBrush}"
                    BorderThickness="1"
                    Padding="8">
                <StackPanel MinWidth="220">
                    <TextBlock Text="Slot GUIDs"
                               Foreground="{StaticResource ForegroundBrush}"
                               FontWeight="Bold"
                               Margin="0,0,0,6" />
                    <ScrollViewer MaxHeight="420"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding GuidFilterItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:FancyToggle Label="{Binding DisplayName}"
                                                          LabelForeground="{Binding LabelForeground}"
                                                          OnText="Show"
                                                          OffText="Hide"
                                                          IsChecked="{Binding IsVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Popup>

        <!-- filters -->
        <ComboBox Grid.Row="0"
                  Grid.Column="0" 
                  HorizontalAlignment="Stretch"
                  Margin="4"
                  ItemsSource="{Binding Regions}"
                  SelectedItem="{Binding SelectedRegion}"/>
        <controls:FancyToggle x:Name="MinesFilter"
                              Grid.Row="1"
                              Grid.Column="0"
                              Label="Mines" 
                              LabelForeground="Gold"
                              OnText="Show" OffText="Hide" 
                              IsChecked="{Binding ShowMines, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
        <controls:FancyToggle x:Name="ClayFilter"
                              Grid.Row="1"
                              Grid.Column="1"
                              Label="Clay" 
                              LabelForeground="Orange"
                              OnText="Show" OffText="Hide" 
                              IsChecked="{Binding ShowClay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
        <controls:FancyToggle x:Name="OilFilter"
                              Grid.Row="1"
                              Grid.Column="2"
                              Label="Oil" 
                              LabelForeground="LightBlue"
                              OnText="Show" OffText="Hide" 
                              IsChecked="{Binding ShowOil, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
        <controls:FancyToggle x:Name="GasFilter"
                              Grid.Row="1"
                              Grid.Column="3"
                              Label="Gas"
                              LabelForeground="Red"
                              OnText="Show" OffText="Hide"
                              IsChecked="{Binding ShowGas, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
        <controls:FancyToggle x:Name="CustomFilter"
                              Grid.Row="1"
                              Grid.Column="4"
                              Label="Unknown"
                              OnText="Show" OffText="Hide"
                              IsChecked="{Binding ShowCustom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                <controls:FancyToggle Grid.Row="0"
                              Grid.Column="1"
                              Label="New World all Ores"
                              OnText="On" OffText="Off"
                              IsChecked="{Binding NewWorldAllOres, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Visibility="{Binding ShowNewWorldAllOres, Converter={StaticResource boolToVisibility}}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
        <controls:FancyToggle Grid.Row="0"
                              Grid.Column="1"
                              Label="Old World all Ores"
                              OnText="On" OffText="Off"
                              IsChecked="{Binding OldWorldAllOres, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Visibility="{Binding ShowOldWorldAllOres, Converter={StaticResource boolToVisibility}}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
        <controls:FancyToggle Grid.Row="0"
                              Grid.Column="1"
                              Label="Arctic all Ores"
                              OnText="On" OffText="Off"
                              IsChecked="{Binding ArcticAllOres, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Visibility="{Binding ShowArcticAllOres, Converter={StaticResource boolToVisibility}}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>

        <!-- region warning -->
        <DockPanel Grid.Row="2"
                   Grid.ColumnSpan="6"
                   Background="DarkRed">
            <TextBlock Text="Slots from regions other than the session's region may not work correctly. Additional mods may be required."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"
                       Foreground="White"/>
        </DockPanel>

        <!-- map -->
        <ListBox x:Name="Map"
                 Grid.Row="3"
                 Grid.ColumnSpan="6"
                 Background="Transparent"
                 ItemsSource="{Binding SlotAssignmentViewModels}"
                 Width="{Binding FixedIsland.IslandAsset.SizeInTiles}"
                 Height="{Binding FixedIsland.IslandAsset.SizeInTiles}"
                 IsEnabled="False">

            <ListBox.LayoutTransform>
                <RotateTransform CenterX="0.5" CenterY="0.5" Angle="-45" />
            </ListBox.LayoutTransform>

            <!-- Thumbnail Canvas -->
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas IsItemsHost="True">
                        <Canvas.Background>
                            <ImageBrush ImageSource="{Binding FixedIsland.IslandAsset.Thumbnail}">
                                <ImageBrush.RelativeTransform>
                                    <TransformGroup>
                                        <RotateTransform CenterX="0.5" CenterY="0.5" Angle="-90"/>
                                    </TransformGroup>
                                </ImageBrush.RelativeTransform>
                            </ImageBrush>
                        </Canvas.Background>
                    </Canvas>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <!-- Items -->
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Canvas.Right" Value="{Binding SlotAssignment.Slot.Position.Y}" />
                    <Setter Property="Canvas.Bottom" Value="{Binding SlotAssignment.Slot.Position.X}" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Width="8"
                            Height="8"
                            CornerRadius="4"
                            BorderThickness="{Binding PathThickness}"
                            Background="{Binding BackgroundBrush}"
                            BorderBrush="{Binding PinBrush}"
                            RenderTransformOrigin="0.5,0.5" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- line canvas -->
        <Canvas x:Name="LineCanvas"
                Grid.Column="0"
                Grid.Row="3"
                Grid.ColumnSpan="4">
        </Canvas>

        <!-- selectors -->
        <ItemsControl x:Name="SlotSelectionsLeft"
                  Grid.Row="3"
                  Grid.Column="0"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                  Background="{StaticResource MediumBackgroundBrush}"
                  BorderThickness="0"
                  ItemsSource="{Binding SlotAssignmentViewModelsLeft}"
                  ItemTemplate="{StaticResource SelectorTemplate}">
        </ItemsControl>
        <ItemsControl x:Name="SlotSelectionsRight"
                  Grid.Row="3"
                  Grid.Column="5"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Background="{StaticResource MediumBackgroundBrush}"
                  BorderThickness="0"
                  ItemsSource="{Binding SlotAssignmentViewModelsRight}"
                  ItemTemplate="{StaticResource SelectorTemplate}">
        </ItemsControl>
    </Grid>
</UserControl>
